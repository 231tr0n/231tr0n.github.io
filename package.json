{
	"name": "231tr0n.github.io",
	"private": true,
	"version": "1",
	"url": "https://231tr0n.github.io",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"show-deps-updates": "npm-check-updates",
		"update-deps": "npx --yes npm-check-updates -u && npm install",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:sw",
		"check:sw": "tsc -p src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "npm run check && prettier --check . && eslint .",
		"lint-fix": "eslint --fix . && prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:coverage": "vitest --run --coverage",
		"ci": "npm ci && npm run lint && npm run build && npm run test"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@html-eslint/eslint-plugin": "^0.68.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-es-x": "^10.1.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-security": "^4.2.1",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"npm-check-updates": "^23.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.1.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"ace-code": "^1.45.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
